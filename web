```html
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Store - Minimalist & Modern E-Commerce</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="h-full flex flex-col text-slate-800 antialiased">

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-30 glass-nav border-b border-slate-200/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand Logo -->
                <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('catalog')">
                    <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-xl shadow-md">
                        A
                    </div>
                    <div>
                        <span class="text-xl font-bold tracking-tight text-slate-900 block leading-none">AURA</span>
                        <span class="text-[10px] tracking-widest text-slate-500 uppercase font-medium">Store Studio</span>
                    </div>
                </div>

                <!-- Navigation Links (Desktop) -->
                <nav class="hidden md:flex items-center gap-1 bg-slate-100/80 p-1 rounded-full border border-slate-200/60">
                    <button onclick="switchTab('catalog')" id="nav-catalog" class="px-5 py-2 rounded-full text-sm font-medium transition-all text-slate-900 bg-white shadow-sm">
                        <i class="fa-solid fa-store mr-2 text-xs"></i>Katalog
                    </button>
                    <button onclick="switchTab('history')" id="nav-history" class="px-5 py-2 rounded-full text-sm font-medium transition-all text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-clock-rotate-left mr-2 text-xs"></i>Riwayat & Tracking
                    </button>
                </nav>

                <!-- Actions Right -->
                <div class="flex items-center gap-3">
                    <!-- Owner Mode Switcher -->
                    <button onclick="openOwnerPinModal()" id="btn-owner-toggle" class="flex items-center gap-2 text-xs font-semibold px-3 py-2 rounded-xl bg-amber-50 text-amber-700 border border-amber-200/80 hover:bg-amber-100 transition-colors">
                        <i class="fa-solid fa-user-shield"></i>
                        <span class="hidden sm:inline" id="owner-badge-text">Mode Pembeli</span>
                    </button>

                    <!-- Cart Button -->
                    <button onclick="toggleCartDrawer()" class="relative p-2.5 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                        <i class="fa-solid fa-bag-shopping text-lg"></i>
                        <span id="cart-count" class="absolute -top-1 -right-1 bg-indigo-600 text-white text-[11px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-white scale-0 transition-transform duration-200">
                            0
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Nav Tab Bar -->
        <div class="md:hidden flex border-t border-slate-200 bg-white/90">
            <button onclick="switchTab('catalog')" id="mobile-nav-catalog" class="flex-1 py-3 text-xs font-semibold text-center text-slate-900 border-b-2 border-slate-900">
                <i class="fa-solid fa-store block text-sm mb-0.5"></i> Katalog
            </button>
            <button onclick="switchTab('history')" id="mobile-nav-history" class="flex-1 py-3 text-xs font-semibold text-center text-slate-500 border-b-2 border-transparent">
                <i class="fa-solid fa-clock-rotate-left block text-sm mb-0.5"></i> Riwayat
            </button>
            <button onclick="switchTab('owner')" id="mobile-nav-owner" class="flex-1 py-3 text-xs font-semibold text-center text-amber-600 border-b-2 border-transparent hidden">
                <i class="fa-solid fa-crown block text-sm mb-0.5"></i> Panel Pemilik
            </button>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- SECTION 1: CATALOG VIEW -->
        <section id="view-catalog" class="space-y-6">
            <!-- Hero Banner -->
            <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-8 sm:p-12 shadow-xl">
                <div class="relative z-10 max-w-xl space-y-3">
                    <span class="px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs font-semibold tracking-wider text-indigo-300 uppercase">Koleksi Terbaru 2026</span>
                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Kualitas Terbaik Untuk Gaya Hidup Anda</h1>
                    <p class="text-slate-300 text-sm sm:text-base font-light">Temukan ragam produk eksklusif pilihan dengan jaminan kualitas dan pengiriman cepat.</p>
                </div>
                <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            </div>

            <!-- Filter & Search Controls -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
                <!-- Search Input -->
                <div class="relative flex-grow">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="search-input" oninput="filterProducts()" placeholder="Cari nama produk..." class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all">
                </div>

                <!-- Category Filters & Sort -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0">
                    <select id="category-filter" onchange="filterProducts()" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-slate-900 cursor-pointer">
                        <option value="all">Semua Kategori</option>
                        <option value="Fashion">Fashion</option>
                        <option value="Elektronik">Elektronik</option>
                        <option value="Aksesoris">Aksesoris</option>
                        <option value="Gaya Hidup">Gaya Hidup</option>
                    </select>

                    <select id="sort-filter" onchange="filterProducts()" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-slate-900 cursor-pointer">
                        <option value="default">Urutkan: Terbaru</option>
                        <option value="price-low">Harga: Rendah ke Tinggi</option>
                        <option value="price-high">Harga: Tinggi ke Rendah</option>
                    </select>
                </div>
            </div>

            <!-- Product Grid -->
            <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Products will be dynamically rendered here -->
            </div>

            <!-- Empty Products State -->
            <div id="empty-products" class="hidden text-center py-16 bg-white rounded-3xl border border-dashed border-slate-300">
                <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-base font-semibold text-slate-700">Produk Tidak Ditemukan</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">Coba gunakan kata kunci pencarian lain atau ganti filter kategori.</p>
            </div>
        </section>

        <!-- SECTION 2: HISTORY & TRACKING VIEW -->
        <section id="view-history" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Riwayat & Tracking Pesanan</h2>
                        <p class="text-xs text-slate-500 mt-1">Pantau status pengiriman dan data transaksi terakhir Anda.</p>
                    </div>
                    
                    <!-- Fast Track Search -->
                    <div class="flex gap-2">
                        <input type="text" id="track-id-input" placeholder="Masukkan ID Pesanan (cth: #ORD-1234)" class="px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-slate-900">
                        <button onclick="trackOrderById()" class="px-4 py-2 bg-slate-900 text-white rounded-xl text-xs font-semibold hover:bg-slate-800 transition-colors">
                            Lacak
                        </button>
                    </div>
                </div>

                <!-- Orders Container -->
                <div id="orders-history-list" class="mt-6 space-y-6">
                    <!-- Orders will be rendered here -->
                </div>
            </div>
        </section>

        <!-- SECTION 3: OWNER DASHBOARD VIEW -->
        <section id="view-owner" class="hidden space-y-6">
            <!-- Top Alert Bar -->
            <div class="bg-amber-500/10 border border-amber-500/20 rounded-2xl p-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-crown"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-amber-900">Panel Pemilik Toko (Owner Mode Active)</h3>
                        <p class="text-xs text-amber-700">Anda memiliki akses penuh untuk mengelola katalog & pesanan.</p>
                    </div>
                </div>
                <button onclick="exitOwnerMode()" class="px-3 py-1.5 bg-amber-200/80 hover:bg-amber-300/80 text-amber-900 rounded-lg text-xs font-semibold transition-colors">
                    Keluar Mode Owner
                </button>
            </div>

            <!-- Analytics Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Penjualan</p>
                        <h4 id="stat-total-sales" class="text-2xl font-bold text-slate-900 mt-1">Rp 0</h4>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-sack-dollar"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Pesanan</p>
                        <h4 id="stat-total-orders" class="text-2xl font-bold text-slate-900 mt-1">0</h4>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Produk Aktif</p>
                        <h4 id="stat-total-products" class="text-2xl font-bold text-slate-900 mt-1">0</h4>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>
                </div>
            </div>

            <!-- Management Tabs Section -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm">
                <!-- Owner Sub Navigation -->
                <div class="flex border-b border-slate-100 gap-6 mb-6">
                    <button onclick="switchOwnerTab('orders')" id="tab-btn-orders" class="pb-3 text-sm font-bold text-slate-900 border-b-2 border-slate-900">
                        <i class="fa-solid fa-list-check mr-2"></i>Kelola Pesanan
                    </button>
                    <button onclick="switchOwnerTab('products')" id="tab-btn-products" class="pb-3 text-sm font-bold text-slate-400 border-b-2 border-transparent hover:text-slate-700">
                        <i class="fa-solid fa-box mr-2"></i>Kelola Produk Katalog
                    </button>
                </div>

                <!-- SUB TAB 1: Kelola Pesanan -->
                <div id="owner-tab-orders" class="space-y-4">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="text-xs font-semibold text-slate-400 uppercase border-b border-slate-100 bg-slate-50/50">
                                    <th class="p-3 rounded-l-xl">ID Pesanan</th>
                                    <th class="p-3">Pelanggan</th>
                                    <th class="p-3">Total</th>
                                    <th class="p-3">Pembayaran</th>
                                    <th class="p-3">Status Pengiriman</th>
                                    <th class="p-3 rounded-r-xl text-right">Aksi Status</th>
                                </tr>
                            </thead>
                            <tbody id="owner-orders-table-body" class="text-xs sm:text-sm divide-y divide-slate-100">
                                <!-- Dynamic Rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- SUB TAB 2: Kelola Produk -->
                <div id="owner-tab-products" class="hidden space-y-6">
                    <div class="flex justify-between items-center">
                        <h3 class="text-base font-bold text-slate-900">Daftar Katalog Produk</h3>
                        <button onclick="openProductModal()" class="px-4 py-2 bg-slate-900 text-white text-xs font-semibold rounded-xl hover:bg-slate-800 transition-all flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Tambah Produk
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="owner-products-grid">
                        <!-- Dynamic Owner Product Cards -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- CART DRAWER OVERLAY -->
    <div id="cart-drawer" class="fixed inset-0 z-50 overflow-hidden pointer-events-none transition-all duration-300">
        <!-- Backdrop -->
        <div id="cart-backdrop" onclick="toggleCartDrawer()" class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-auto"></div>

        <!-- Slide Panel -->
        <div id="cart-panel" class="absolute inset-y-0 right-0 max-w-full flex pl-10 transform translate-x-full transition-transform duration-300 ease-in-out pointer-events-auto">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col">
                <!-- Drawer Header -->
                <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-bag-shopping text-slate-900 text-lg"></i>
                        <h2 class="text-lg font-bold text-slate-900">Keranjang Belanja</h2>
                    </div>
                    <button onclick="toggleCartDrawer()" class="p-2 text-slate-400 hover:text-slate-600 rounded-lg">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <!-- Cart Items List -->
                <div id="cart-items-container" class="flex-grow overflow-y-auto p-6 space-y-4 divide-y divide-slate-100">
                    <!-- Items inserted via JS -->
                </div>

                <!-- Drawer Footer -->
                <div class="p-6 border-t border-slate-100 bg-slate-50 space-y-4">
                    <div class="space-y-1.5 text-xs">
                        <div class="flex justify-between text-slate-500">
                            <span>Subtotal</span>
                            <span id="cart-subtotal" class="font-medium text-slate-700">Rp 0</span>
                        </div>
                        <div class="flex justify-between text-slate-500">
                            <span>Biaya Pengiriman</span>
                            <span class="font-medium text-emerald-600">Gratis</span>
                        </div>
                        <div class="flex justify-between text-sm font-bold text-slate-900 pt-2 border-t border-slate-200">
                            <span>Total Tagihan</span>
                            <span id="cart-total" class="text-indigo-600">Rp 0</span>
                        </div>
                    </div>

                    <button onclick="openCheckoutModal()" id="btn-proceed-checkout" disabled class="w-full py-3 px-4 bg-slate-900 text-white text-sm font-bold rounded-xl disabled:bg-slate-300 disabled:cursor-not-allowed hover:bg-slate-800 transition-all flex items-center justify-center gap-2 shadow-lg shadow-slate-900/10">
                        Proses Checkout <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 1: CHECKOUT & PAYMENT GATEWAY SIMULATOR -->
    <div id="modal-checkout" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm overflow-y-auto">
        <div class="bg-white w-full max-w-xl rounded-3xl shadow-2xl overflow-hidden my-8">
            <!-- Modal Header -->
            <div class="p-6 bg-slate-900 text-white flex justify